# Copy to .env, then fill sensitive values locally. Never commit .env.
ELEVENLABS_API_KEY=

# Fixed production provider: DeepSeek official API. Model is server-configurable.
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
VISUAL_LLM_MODEL=deepseek-v4-pro
# Thinking is always enabled. Use high normally; change to max only when needed.
LLM_REASONING_EFFORT=high

ANALYSIS_SERVICE_TOKEN=
ANALYSIS_CALLBACK_TOKEN=
SITES_BYPASS_TOKEN=
REQUEST_TIMEOUT_SECONDS=180
