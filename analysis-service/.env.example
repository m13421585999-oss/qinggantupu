ELEVENLABS_API_KEY=replace-with-server-secret

# Recommended production provider: DeepSeek's OpenAI-compatible API.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Optional Vercel AI Gateway fallback. Leave empty when using LLM_API_KEY.
AI_GATEWAY_API_KEY=

ANALYSIS_SERVICE_TOKEN=generate-a-long-random-token
ANALYSIS_CALLBACK_TOKEN=generate-another-long-random-token
SITES_BYPASS_TOKEN=owner-only-sites-service-bypass-token
REQUEST_TIMEOUT_SECONDS=180
