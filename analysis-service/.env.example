# Copy to .env, then fill sensitive values locally. Never commit .env.
ELEVENLABS_API_KEY=

# Canonical structured LLM configuration. Recitation Interpreter and Visual
# Director share the provider/model but keep separate prompts and schemas.
LLM_PROVIDER=openai_compatible
AI_BASE_URL=https://api2.65535.space
AI_API_KEY=
LLM_MODEL=gpt-5.6-sol
# Responses API is preferred. Gateways without it fall back to Chat Completions.
# Set LLM_PROVIDER=deepseek and AI_BASE_URL=https://api.deepseek.com to use the
# retained official DeepSeek adapter.
LLM_REASONING_EFFORT=high
VISUAL_REASONING_EFFORT=low
# Recitation interpretation uses the retained official DeepSeek adapter.
# Leave RECITATION_LLM_API_KEY empty to reuse legacy LLM_API_KEY.
RECITATION_LLM_PROVIDER=deepseek
RECITATION_LLM_BASE_URL=https://api.deepseek.com
RECITATION_LLM_MODEL=deepseek-v4-pro
RECITATION_LLM_API_KEY=
RECITATION_REASONING_EFFORT=high

# Image generation can use a dedicated gateway and key. Leave either value
# empty to fall back to AI_BASE_URL / AI_API_KEY (then legacy LLM_* variables).
IMAGE_PROVIDER=openai_compatible
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
# Hero text validation remains on the structured LLM connection above.
# Optional. Defaults to LLM_MODEL when unset.
IMAGE_OCR_MODEL=

ANALYSIS_SERVICE_TOKEN=
ANALYSIS_CALLBACK_TOKEN=
SITES_BYPASS_TOKEN=
REQUEST_TIMEOUT_SECONDS=270
