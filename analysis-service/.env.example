ELEVENLABS_API_KEY=replace-with-server-secret

# Vercel production uses its automatically injected VERCEL_OIDC_TOKEN after
# AI Gateway is enabled for the project. For local development only, set a
# static AI Gateway key here instead.
AI_GATEWAY_API_KEY=
LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_MODEL=openai/gpt-5.6-sol

ANALYSIS_SERVICE_TOKEN=generate-a-long-random-token
ANALYSIS_CALLBACK_TOKEN=generate-another-long-random-token
SITES_BYPASS_TOKEN=owner-only-sites-service-bypass-token
REQUEST_TIMEOUT_SECONDS=180
